# Briefklar API – Umgebungsvariablen
# Kopieren nach .env (wird nicht eingecheckt) oder direkt beim Hoster setzen.

# Pflicht für echte Anfragen: API-Schlüssel von https://console.anthropic.com
# Der Server startet auch ohne Schlüssel, POST /api/explain liefert dann internal_error.
ANTHROPIC_API_KEY=

# Port, auf dem die API lauscht (Render/Fly setzen PORT selbst). Standard: 8787
PORT=8787

# Claude-Modell für die Brieferklärung. Standard: claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# Denk-Aufwand des Modells: low | medium | high | xhigh | max. Standard: medium
# Höher = gründlicher, aber langsamer und teurer.
ANTHROPIC_EFFORT=medium

# Max. Anfragen an /api/explain pro IP in 15 Minuten. 0 = alles blockieren. Standard: 20
RATE_LIMIT_PER_15MIN=20

# Erlaubte Browser-Origins für /api/* (kommagetrennt) oder * für alle. Standard: *
# Wenn die Web-App aus STATIC_DIR mit ausgeliefert wird, reicht *.
CORS_ORIGIN=

# Optional: Verzeichnis mit der gebauten Web-App (Vite-Build). Wenn gesetzt,
# liefert die API die Dateien mit aus (SPA-Fallback auf index.html).
# Im Docker-Image: /app/apps/web/dist
STATIC_DIR=

# Auf "true" setzen, wenn die API hinter einem Reverse-Proxy/Load-Balancer läuft
# (Render, Fly, nginx …), damit das Rate-Limit die echte Client-IP aus
# X-Forwarded-For nimmt. Ohne Proxy unbedingt weglassen (sonst fälschbar).
TRUST_PROXY=false

# Hinweis Datenschutz: ANTHROPIC_LOG=debug würde das SDK Request-Bodies (also
# Bilddaten) loggen – in Produktion niemals setzen.
