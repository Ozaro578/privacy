# Claude API Key (https://platform.claude.com) – fuer die Skript-Generierung
ANTHROPIC_API_KEY=sk-ant-...

# Optional: HTTP(S)-Proxy fuer edge-tts, falls noetig
# TTS_PROXY=http://127.0.0.1:8080

# Optional: kostenloser Pexels-Key (https://www.pexels.com/api/) fuer Stock-Hintergrundvideos
# PEXELS_API_KEY=...

# ChatGPT / OpenAI API Key (https://platform.openai.com/api-keys) – Standard-Provider fuer Skripte
OPENAI_API_KEY=sk-...

# Higgsfield API (https://console.higgsfield.ai -> API Keys). Format: id:secret
HF_KEY=hf_key_id:hf_key_secret
