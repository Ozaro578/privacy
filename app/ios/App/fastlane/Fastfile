# ZUKKABRO iOS: Build und Upload zu TestFlight (läuft in GitHub Actions auf einem macOS-Runner)
# Benötigte Umgebungsvariablen (GitHub Secrets): APPLE_TEAM_ID, ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64, MATCH_PASSWORD
# Zertifikate liegen verschlüsselt im selben Repo auf dem Branch "zertifikate" (GITHUB_TOKEN reicht).
default_platform(:ios)

platform :ios do
  desc "Signierte App bauen und zu TestFlight hochladen"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # Zertifikat + Profil liegen verschlüsselt (MATCH_PASSWORD) im Repo auf dem Branch "zertifikate". Beim ersten Lauf werden sie angelegt.
    match(
      type: "appstore",
      app_identifier: "de.zukkabro.app",
      api_key: api_key,
      readonly: false,
      git_url: ENV["MATCH_GIT_URL"] || "https://github.com/#{ENV.fetch('GITHUB_REPOSITORY')}.git",
      git_branch: "zertifikate",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}"),
      storage_mode: "git"
    )

    build_nummer = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
    increment_build_number(build_number: build_nummer, xcodeproj: "App.xcodeproj")

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "de.zukkabro.app",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["de.zukkabro.app"]
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "ZUKKABRO.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Neuer Build #{build_nummer}: Website-Stand von zukkabro.de"
    )
  end
end
